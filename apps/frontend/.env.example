# Vite inlines VITE_-prefixed vars at build time; restart the dev server after changing.
# Backend base URL.
VITE_API_URL=http://localhost:4000
# Web app API key for /public/* (mint with `select public.create_api_key('webapp')`).
# It identifies the client; it is not a secret, it ships in the bundle.
VITE_API_KEY=
# Supabase project (Settings > API): URL and publishable key, used for Google sign-in only.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
